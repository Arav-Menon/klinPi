{
  "name": "klinpi",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "repository": "https://github.com/Arav-Menon/klinPi",
  "author": "Arav-menon",
  "license": "MIT",
  "scripts": {
    "test": "vitest",
    "dev:studio": "cd packages/studio && pnpm dev",
    "dev:gateway": "cd packages/gateway && pnpm run dev",
    "studio:dev": "pnpm --filter @klinpi/studio dev",
    "studio:build": "pnpm --filter @klinpi/studio build",
    "studio:lint": "pnpm --filter @klinpi/studio lint",
    "prisma:generate": "pnpm --filter @klinpi/prisma exec prisma generate",
    "prisma:migrate": "pnpm --filter @klinpi/prisma exec prisma migrate dev",
    "prisma:studio": "pnpm --filter @klinpi/prisma exec prisma studio"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.2",
    "@types/supertest": "^7.2.1",
    "prisma": "^7.9.1",
    "supertest": "^7.2.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "axios": "^1.19.0",
    "bcrypt": "^5.1.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "@klinpi/prisma": "workspace:*"
  }
}