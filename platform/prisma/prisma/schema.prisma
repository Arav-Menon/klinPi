generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum SessionStatus {
  ACTIVE
  PAUSED
  COMPLETED
  FAILED
  ARCHIVED
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
  TOOL
}

enum AgentRunStatus {
  QUEUED
  RUNNING
  WAITING_FOR_USER
  COMPLETED
  FAILED
  CANCELLED
}

enum ToolCallStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum SandboxStatus {
  CREATING
  RUNNING
  STOPPED
  DESTROYED
  FAILED
}

enum RepositoryProvider {
  GITHUB
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  passwordHash  String?
  name          String?
  avatarUrl     String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  oauthAccounts OAuthAccount[]
  sessions      AgentSession[]
  repositories  Repository[]
}

model OAuthAccount {
  id                String    @id @default(cuid())
  userId            String
  provider          String
  providerAccountId String
  accessToken       String?
  refreshToken      String?
  expiresAt         DateTime?
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Repository {
  id             String             @id @default(cuid())
  userId         String
  provider       RepositoryProvider
  providerRepoId String
  owner          String
  name           String
  fullName       String
  cloneUrl       String
  defaultBranch  String
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions       AgentSession[]

  @@unique([provider, providerRepoId])
  @@index([userId])
}

model AgentSession {
  id           String        @id @default(cuid())
  userId       String
  repositoryId String?
  title        String?
  status       SessionStatus @default(ACTIVE)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  repository   Repository?   @relation(fields: [repositoryId], references: [id], onDelete: SetNull)
  messages     Message[]
  runs         AgentRun[]
  sandboxes    Sandbox[]

  @@index([userId, updatedAt])
  @@index([repositoryId])
}

model Message {
  id        String       @id @default(cuid())
  sessionId String
  role      MessageRole
  content   String
  // Optional metadata:
  // model, token usage, etc.
  metadata  Json?
  createdAt DateTime     @default(now())
  session   AgentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  toolCalls ToolCall[]

  @@index([sessionId, createdAt])
}

model AgentRun {
  id          String         @id @default(cuid())
  sessionId   String
  status      AgentRunStatus @default(QUEUED)
  startedAt   DateTime?
  completedAt DateTime?
  error       String?
  metadata    Json? // what metadata need to send here
  session     AgentSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  toolCalls ToolCall[]
  approvals Approval[]
  createdAt DateTime   @default(now())

  @@index([sessionId, createdAt])
}

model ToolCall {
  id          String         @id @default(cuid())
  agnetId     String
  messageId   String?
  toolName    String
  status      ToolCallStatus @default(PENDING)
  input       Json
  output      Json?
  error       String?
  startedAt   DateTime?
  completedAt DateTime?
  run         AgentRun       @relation(fields: [agnetId], references: [id], onDelete: Cascade)
  message     Message?       @relation(fields: [messageId], references: [id], onDelete: SetNull)

  @@index([agnetId])
  @@index([messageId])
}

model Sandbox {
  id                String @id @default(cuid())
  sessionId         String
  // ID returned by E2B
  providerSandboxId String @unique

  provider String @default("e2b")

  status SandboxStatus @default(CREATING)

  // Repository state inside this sandbox
  workspacePath String?

  branchName   String?
  commitSha    String?
  createdAt    DateTime     @default(now())
  lastActiveAt DateTime?
  destroyedAt  DateTime?
  session      AgentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, status])
}

model Approval {
  id        String         @id @default(cuid())
  agentId   String
  toolName  String
  input     Json
  status    ApprovalStatus @default(PENDING)
  // decision: { action: "reject", message: "Don't delete node_modules, just run pnpm install."}, or { decision : { action : "apoprove" }}
  decision  Json?
  createdAt DateTime       @default(now())
  decidedAt DateTime?
  expiresAt DateTime?
  run       AgentRun       @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId, status])
}
