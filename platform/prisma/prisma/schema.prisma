generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum SessionStatus {
  ACTIVE
  PAUSED
  COMPLETED
  FAILED
  ARCHIVED
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
  TOOL
}

enum AgentRunStatus {
  QUEUED
  RUNNING
  WAITING_FOR_USER
  COMPLETED
  FAILED
  CANCELLED
}

enum ToolCallStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum SandboxStatus {
  CREATING
  RUNNING
  STOPPED
  DESTROYED
  FAILED
}

enum RepositoryProvider {
  GITHUB
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

// ─────────────────────────────────────────────
// USER
// ─────────────────────────────────────────────

model User {
  id           String  @id @default(cuid())
  email        String  @unique
  passwordHash String?
  name         String?
  avatarUrl    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  oauthAccounts OAuthAccount[]
  sessions      AgentSession[]
  repositories  Repository[]
}

// ─────────────────────────────────────────────
// OAUTH
// ─────────────────────────────────────────────

model OAuthAccount {
  id     String @id @default(cuid())
  userId String

  provider          String
  providerAccountId String

  accessToken  String?
  refreshToken String?
  expiresAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

// ─────────────────────────────────────────────
// REPOSITORY
// ─────────────────────────────────────────────

model Repository {
  id     String @id @default(cuid())
  userId String

  provider       RepositoryProvider
  providerRepoId String
  owner          String
  name           String
  fullName       String
  cloneUrl       String
  defaultBranch  String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions AgentSession[]

  @@unique([provider, providerRepoId])
  @@index([userId])
}

// ─────────────────────────────────────────────
// AGENT SESSION
// ─────────────────────────────────────────────

model AgentSession {
  id           String  @id @default(cuid())
  userId       String
  repositoryId String?

  title  String?
  status SessionStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  repository Repository? @relation(fields: [repositoryId], references: [id], onDelete: SetNull)

  messages  Message[]
  runs      AgentRun[]
  sandboxes Sandbox[]

  @@index([userId, updatedAt])
  @@index([repositoryId])
}

// ─────────────────────────────────────────────
// CHAT / AGENT MESSAGES
// ─────────────────────────────────────────────

model Message {
  id        String @id @default(cuid())
  sessionId String

  role    MessageRole
  content String

  // Optional metadata:
  // model, token usage, etc.
  metadata Json?

  createdAt DateTime @default(now())

  session AgentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  toolCalls ToolCall[]

  @@index([sessionId, createdAt])
}

// ─────────────────────────────────────────────
// AGENT RUN
// ─────────────────────────────────────────────

model AgentRun {
  id        String @id @default(cuid())
  sessionId String

  status AgentRunStatus @default(QUEUED)

  startedAt   DateTime?
  completedAt DateTime?

  error String?

  metadata Json?

  session AgentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  toolCalls ToolCall[]
  approvals Approval[]
  createdAt DateTime   @default(now())

  @@index([sessionId, createdAt])
}

// ─────────────────────────────────────────────
// TOOL CALL
// ─────────────────────────────────────────────

model ToolCall {
  id        String  @id @default(cuid())
  runId     String
  messageId String?

  toolName String

  status ToolCallStatus @default(PENDING)

  // Arguments sent to the tool
  input Json

  // Tool output
  output Json?

  error String?

  startedAt   DateTime?
  completedAt DateTime?

  run     AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  message Message? @relation(fields: [messageId], references: [id], onDelete: SetNull)

  @@index([runId])
  @@index([messageId])
}

// ─────────────────────────────────────────────
// SANDBOX
// ─────────────────────────────────────────────

model Sandbox {
  id        String @id @default(cuid())
  sessionId String

  // ID returned by E2B
  providerSandboxId String @unique

  provider String @default("e2b")

  status SandboxStatus @default(CREATING)

  // Repository state inside this sandbox
  workspacePath String?

  branchName String?
  commitSha  String?

  createdAt    DateTime  @default(now())
  lastActiveAt DateTime?
  destroyedAt  DateTime?

  session AgentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, status])
}

// ─────────────────────────────────────────────
// USER APPROVALS
// ─────────────────────────────────────────────

model Approval {
  id    String @id @default(cuid())
  runId String

  toolName String

  // What the agent wants permission to do
  input Json

  status ApprovalStatus @default(PENDING)

  createdAt DateTime  @default(now())
  expiresAt DateTime?

  run AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, status])
}
